<UserControl x:Class="QueueSidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="clr-namespace:LazyTranslate;assembly=LazyTranslate"
             xmlns:local="clr-namespace:CompactGUI"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="PageRoot"
             HorizontalContentAlignment="Stretch"
             d:DataContext="{d:DesignInstance Type=local:HomeViewModel}"
             TextBlock.Foreground="{StaticResource TextControlForeground}"
             mc:Ignorable="d">
    <Border BorderBrush="{StaticResource SeparatorBorderBrush}" BorderThickness="0" CornerRadius="6">
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="0 0 0 12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center"
                               FontSize="18" FontWeight="SemiBold" Text="Queue" />
                    <TextBlock Margin="8 3 0 0" VerticalAlignment="Center"
                               Foreground="{StaticResource CardForegroundDisabled}"
                               Text="{Binding Folders.Count, StringFormat={}({0})}" />
                </StackPanel>
                <ui:Button Grid.Column="1"
                           Width="34" Height="34"
                           Padding="0"
                           Click="AddFolderButton_Click" ToolTip="Add folder">
                    <ui:SymbolIcon Symbol="Add16" />
                </ui:Button>
                <ui:Button Grid.Column="2"
                           Width="34" Height="34"
                           Margin="6 0 0 0" Padding="0"
                           Command="{Binding DataContext.ToggleQueueSidebarCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                           ToolTip="Close queue"
                           Visibility="{Binding ShowCloseButton, RelativeSource={RelativeSource AncestorType=local:QueueSidebar}, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:SymbolIcon Symbol="Dismiss12" />
                </ui:Button>
            </Grid>

            <ui:ListView Grid.Row="1"
                         Padding="0"
                         Background="Transparent" BorderThickness="0"
                         ItemsSource="{Binding Folders}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectedItem="{Binding SelectedFolder, Mode=TwoWay}">
                <ui:ListView.ItemContainerStyle>
                    <Style BasedOn="{StaticResource {x:Type ui:ListViewItem}}" TargetType="ui:ListViewItem">
                        <Setter Property="Margin" Value="0 0 0 0" />
                        <Setter Property="Padding" Value="0 -5" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    </Style>
                </ui:ListView.ItemContainerStyle>
                <ui:ListView.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="ItemCard"
                                Padding="0"
                                Background="Transparent" CornerRadius="6"
                                Tag="{Binding DataContext, ElementName=PageRoot}"
                                TextBlock.Foreground="{StaticResource TextControlForeground}">
                            <Border.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Command="{Binding Tag.RemoveFolderCommand}" CommandParameter="{Binding DataContext}" Header="Remove From Queue" />

                                </ContextMenu>
                            </Border.ContextMenu>
                            <Grid Margin="10" Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!--<Border Width="4" Height="48"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource AccentFillColorDefaultBrush}"
                                        CornerRadius="2"
                                        Visibility="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListViewItem}, Converter={StaticResource BooleanToVisibilityConverter}}" />-->
                                <Grid Grid.Column="1" Margin="0 0 0 0" VerticalAlignment="Center">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock FontSize="13" FontWeight="SemiBold"
                                               Text="{Binding DisplayName}"
                                               TextTrimming="CharacterEllipsis" />
                                    <Grid Grid.Row="1" Margin="0 5 0 0" HorizontalAlignment="Stretch">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Ellipse Width="10" Height="10"
                                                 Margin="0 0 7 0" VerticalAlignment="Center"
                                                 Fill="{Binding FolderActionState, Converter={StaticResource FolderStatusToColorConverter}}" />
                                        <TextBlock Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   FontSize="11"
                                                   Foreground="{StaticResource CardForegroundDisabled}"
                                                   Text="{Binding FolderActionState, Converter={StaticResource FolderStatusToStringConverter}}" />
                                        <Border Grid.Column="2"
                                                Width="40" Height="25"
                                                Margin="10 0 0 0" VerticalAlignment="Center"
                                                Background="#8373808C" CornerRadius="5">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding FolderActionState}" Value="Idle">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding FolderActionState}" Value="Results">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       FontSize="11" FontWeight="SemiBold" Foreground="#FFF"
                                                       Text="{Binding CompressionOptions.SelectedCompressionMode, Converter={StaticResource CompressionModeAbbreviatedConverter}}" />
                                        </Border>
                                        <ProgressBar Grid.Column="3"
                                                     Height="8"
                                                     Margin="10 0 0 0" VerticalAlignment="Center"
                                                     Background="{StaticResource CardBackgroundPressed}"
                                                     Foreground="#92F1AB"
                                                     Visibility="{Binding FolderActionState, Converter={StaticResource FolderActionStateWorkingToVisibilityConverter}}"
                                                     Value="{Binding CompressionProgress.ProgressPercent}" />



                                    </Grid>
                                    <!--<Grid Grid.Row="2" Margin="0 5 0 0" Visibility="{Binding FolderActionState, Converter={StaticResource FolderActionStateWorkingToVisibilityConverter}}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        --><!--<TextBlock FontSize="10" Foreground="{StaticResource CardForegroundDisabled}" Text="{Binding CompressionProgress.FileName, Converter={StaticResource TokenisedFolderPathConverter}, ConverterParameter=TrimStart}" />--><!--

                                    </Grid>-->
                                </Grid>

                                <ui:Button Grid.Column="1"
                                           Width="26" Height="26"
                                           Padding="0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           BorderBrush="{StaticResource PaletteRedBrush}"
                                           Command="{Binding Tag.RemoveFolderCommand, RelativeSource={RelativeSource AncestorType=Border}}"
                                           CommandParameter="{Binding}">
                                    <ui:SymbolIcon FontSize="12" Foreground="{StaticResource PaletteRedBrush}" Symbol="Dismiss12" />
                                    <ui:Button.Style>
                                        <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
                                            <Setter Property="Opacity" Value="0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                </ui:Button>

                            </Grid>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Height" Value="74" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="True">
                                            <Setter Property="Background" Value="#3345A9E8" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding FolderActionState}" Value="Working" />
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                    </DataTemplate>
                </ui:ListView.ItemTemplate>
            </ui:ListView>

            <StackPanel Grid.Row="2" Margin="0 12 0 0">
                <TextBlock HorizontalAlignment="Center"
                           FontSize="11"
                           Foreground="{StaticResource CardForegroundDisabled}"
                           Text="{Binding QueueStatusSummary}" />
                <StackPanel Margin="0 3 0 8" HorizontalAlignment="Center" Orientation="Horizontal">
                    <StackPanel MinWidth="78">
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="10"
                                   Foreground="{StaticResource CardForegroundDisabled}"
                                   Text="Queued" />
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="12" FontWeight="SemiBold"
                                   Text="{Binding TotalQueuedSize, Mode=OneWay, Converter={StaticResource BytesToReadableConverter}}" />
                    </StackPanel>
                    <StackPanel MinWidth="104" Margin="14 0 0 0" Visibility="{Binding HasAwaitingFolders, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="10"
                                   Foreground="{StaticResource CardForegroundDisabled}"
                                   Text="Estimated savings" />
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="12" FontWeight="SemiBold" Foreground="#45c1e8"
                                   Text="{Binding AwaitingEstimatedSavings, Mode=OneWay, Converter={StaticResource BytesToReadableConverter}}" />
                    </StackPanel>
                    <StackPanel MinWidth="78" Margin="14 0 0 0" Visibility="{Binding HasCompressedFolders, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="10"
                                   Foreground="{StaticResource CardForegroundDisabled}"
                                   Text="Saved" />
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="12" FontWeight="SemiBold" Foreground="#65dc9d"
                                   Text="{Binding TotalSaved, Mode=OneWay, Converter={StaticResource BytesToReadableConverter}}" />
                    </StackPanel>
                </StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:Button Height="36"
                               HorizontalAlignment="Stretch"
                               Command="{Binding CompressAllCommand}"
                               Content="Begin Compression"
                               Visibility="{Binding IsQueueRunning, Converter={StaticResource BooleanToInverseVisibilityConverter}}" />
                    <StackPanel Grid.Column="0"
                                HorizontalAlignment="Center"
                                Orientation="Horizontal"
                                Visibility="{Binding IsQueueRunning, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ui:Button Height="36" Command="{Binding ActiveFolderViewModel.PauseCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Filled="True" Symbol="{Binding ActiveFolderViewModel.Folder.FolderActionState, Converter={StaticResource FolderWorkingStateToPauseSymbolConverter}}" />
                                <TextBlock Margin="8 0 0 0">
                                    <TextBlock.Style>
                                        <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="TextBlock">
                                            <Setter Property="Text" Value="Pause Queue" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActiveFolderViewModel.Folder.FolderActionState}" Value="{x:Static local:ActionState.Paused}">
                                                    <Setter Property="Text" Value="Resume Queue" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Height="36"
                                   Margin="8 0 0 0"
                                   Command="{Binding ActiveFolderViewModel.CancelCommand}">
                            <StackPanel Orientation="Horizontal">

                                <ui:SymbolIcon Foreground="{StaticResource PaletteRedBrush}" Symbol="Dismiss12" />
                                <TextBlock Margin="8 0 0 0" Text="Cancel Queue" Foreground="{StaticResource PaletteRedBrush}">
                                    
                                </TextBlock>
                            </StackPanel>
                        </ui:Button>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
