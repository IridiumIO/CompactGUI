<UserControl x:Class="SteamMonitorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:CompactGUI.Core;assembly=CompactGUI.Core"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="clr-namespace:LazyTranslate;assembly=LazyTranslate"
             xmlns:local="clr-namespace:CompactGUI"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="PageRoot"
             d:DataContext="{d:DesignInstance Type=local:SteamMonitorViewModel}"
             d:DesignHeight="600"
             d:DesignWidth="1100"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded"
             mc:Ignorable="d">

    <Grid Margin="40 20 20 0">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="40" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <TextBlock VerticalAlignment="Top"
                       loc:L.Value="Steam Library" FontSize="26"
                       Foreground="{StaticResource CardForeground}" />
            <ui:Button Width="32" Height="32"
                       Margin="10 2 0 0" Padding="0" VerticalAlignment="Top"
                       Background="Transparent" BorderThickness="0"
                       Command="{Binding RefreshAllCommand}"
                       ToolTip="{loc:T Reload Steam Library list}"
                       Visibility="{Binding IsAnalysingGames, Converter={StaticResource BooleanToInverseVisibilityConverter}}">
                <ui:SymbolIcon Margin="0 5 0 0" FontSize="18" Symbol="ArrowClockwise16" />
            </ui:Button>
            <ui:ProgressRing Width="20" Height="20"
                             Margin="15 0 0 0"
                             IsIndeterminate="{Binding IsAnalysingGames}"
                             Visibility="{Binding IsAnalysingGames, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </StackPanel>

        <Grid Grid.Row="0" Margin="20 0" HorizontalAlignment="Right">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox MinWidth="250"
                        VerticalAlignment="Center"
                        FontSize="14"
                        PlaceholderText="{loc:T 'Search by game name or SteamID...'}"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            <ui:DropDownButton Grid.Column="1"
                               Height="36"
                               Margin="20 0 0 0" VerticalAlignment="Center"
                               Foreground="{StaticResource LabelForeground}">
                <ui:DropDownButton.Style>
                    <Style BasedOn="{StaticResource {x:Type ui:DropDownButton}}" TargetType="ui:DropDownButton">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasActiveFilters}" Value="True">
                                <Setter Property="Background" Value="#3044BEDF" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ui:DropDownButton.Style>
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Filter12" />
                    <TextBlock Margin="5 0 0 0" loc:L.Value="Filter" />
                </StackPanel>
                <ui:DropDownButton.Flyout>
                    <ContextMenu>
                        <MenuItem Header="{loc:T Library location}" ItemsSource="{Binding LibraryLocations}">
                            <MenuItem.ItemContainerStyle>
                                <Style TargetType="MenuItem">
                                    <Setter Property="Header" Value="{Binding DisplayPath}" />
                                    <Setter Property="Command" Value="{Binding Command}" />
                                    <Setter Property="CommandParameter" Value="{Binding DisplayPath}" />
                                </Style>
                            </MenuItem.ItemContainerStyle>
                        </MenuItem>
                        <MenuItem Header="{loc:T Status}">
                            <MenuItem Command="{Binding FilterStatusCommand}" CommandParameter="{x:Static local:SteamGameStatus.Compressed}" Header="{loc:T Compressed}" />
                            <MenuItem Command="{Binding FilterStatusCommand}" CommandParameter="{x:Static local:SteamGameStatus.Uncompressed}" Header="{loc:T Uncompressed}" />
                            <MenuItem Command="{Binding FilterStatusCommand}" CommandParameter="{x:Static local:SteamGameStatus.PendingSteamUpdate}" Header="{loc:T Update Available}" />
                            <MenuItem Command="{Binding FilterStatusCommand}" CommandParameter="{x:Static local:SteamGameStatus.RecentlyUpdated}" Header="{loc:T Recently Updated}" />
                        </MenuItem>
                        <MenuItem Header="{loc:T Recommended Action}">
                            <MenuItem Command="{Binding FilterRecommendedActionCommand}" CommandParameter="{x:Static local:SteamRecommendedAction.Compress}" Header="{loc:T Compress}" />
                            <MenuItem Command="{Binding FilterRecommendedActionCommand}" CommandParameter="{x:Static local:SteamRecommendedAction.DoNotCompress}" Header="{loc:T Do Not Compress}" />
                            <MenuItem Command="{Binding FilterRecommendedActionCommand}" CommandParameter="{x:Static local:SteamRecommendedAction.UpdateInSteam}" Header="{loc:T Update in Steam}" />
                        </MenuItem>
                        <Separator />
                        <MenuItem Command="{Binding ClearFiltersCommand}" Header="{loc:T Clear filters}" />
                    </ContextMenu>
                </ui:DropDownButton.Flyout>
            </ui:DropDownButton>

            <ui:DropDownButton Grid.Column="2"
                               Height="36"
                               Margin="20 0 0 0" VerticalAlignment="Center"
                               Foreground="{StaticResource LabelForeground}">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="ArrowSort16" />
                    <TextBlock Margin="5 0 0 0" loc:L.Value="Sort" />
                </StackPanel>
                <ui:DropDownButton.Flyout>
                    <ContextMenu>
                        <MenuItem Header="{loc:T Game Name}">
                            <MenuItem Command="{Binding SortCommand}" CommandParameter="GameNameAsc" Header="{loc:T Ascending}" />
                            <MenuItem Command="{Binding SortCommand}" CommandParameter="GameNameDesc" Header="{loc:T Descending}" />
                        </MenuItem>
                        <MenuItem Header="{loc:T Status}">
                            <MenuItem Command="{Binding SortCommand}" CommandParameter="StatusAsc" Header="{loc:T Ascending}" />
                            <MenuItem Command="{Binding SortCommand}" CommandParameter="StatusDesc" Header="{loc:T Descending}" />
                        </MenuItem>
                        <MenuItem Header="{loc:T Current Size}">
                            <MenuItem Command="{Binding SortCommand}" CommandParameter="CurrentSizeAsc" Header="{loc:T Ascending}" />
                            <MenuItem Command="{Binding SortCommand}" CommandParameter="CurrentSizeDesc" Header="{loc:T Descending}" />
                        </MenuItem>
                        <MenuItem Header="{loc:T Savings}">
                            <MenuItem Command="{Binding SortCommand}" CommandParameter="SavingsAsc" Header="{loc:T Ascending}" />
                            <MenuItem Command="{Binding SortCommand}" CommandParameter="SavingsDesc" Header="{loc:T Descending}" />
                        </MenuItem>
                        <MenuItem Header="{loc:T Recommended Action}">
                            <MenuItem Command="{Binding SortCommand}" CommandParameter="RecommendedActionAsc" Header="{loc:T Ascending}" />
                            <MenuItem Command="{Binding SortCommand}" CommandParameter="RecommendedActionDesc" Header="{loc:T Descending}" />
                        </MenuItem>
                    </ContextMenu>
                </ui:DropDownButton.Flyout>
            </ui:DropDownButton>
            <ui:DropDownButton Grid.Column="3"
                               Height="36"
                               Margin="20 0 0 0" VerticalAlignment="Center"
                               Foreground="{StaticResource LabelForeground}">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="MultiselectLtr16" />
                    <TextBlock Margin="5 0 0 0" loc:L.Value="Select" />
                </StackPanel>
                <ui:DropDownButton.Flyout>
                    <ContextMenu>
                        <MenuItem Click="OnSelectAllClick" Header="{loc:T Select all}" />
                        <MenuItem Click="OnSelectAllCompressableClick" Header="{loc:T Select all compressable}" />
                        <Separator />
                        <MenuItem Click="OnDeselectAllClick" Header="{loc:T Deselect all}" />
                    </ContextMenu>
                </ui:DropDownButton.Flyout>
            </ui:DropDownButton>
        </Grid>

        <StackPanel Grid.Row="1" Grid.RowSpan="2"
                    Margin="0 -10 0 20"
                    Orientation="Horizontal"
                    TextBlock.Foreground="{StaticResource TextControlForeground}">
            <TextBlock VerticalAlignment="Bottom" FontSize="20" Text="{Binding SteamGamesData.Count}" />
            <TextBlock Margin="10 0 0 1" VerticalAlignment="Bottom"
                       loc:L.Value="games"
                       Foreground="{StaticResource TextControlForegroundDisabled}" />
            <Separator Height="30"
                       Margin="10 0 10 -2" VerticalAlignment="Bottom"
                       BorderThickness="1" />
            <ui:ProgressRing Width="14" Height="14"
                             Margin="0 0 5 4" VerticalAlignment="Bottom"
                             Foreground="#63ffa1"
                             IsIndeterminate="{Binding IsAnalysingGames}"
                             Visibility="{Binding IsAnalysingGames, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <TextBlock VerticalAlignment="Bottom"
                       FontSize="20" Foreground="#63ffa1" Opacity="0.6"
                       Text="{Binding TotalSaved, Converter={StaticResource BytesToReadableConverter}}" />
            <TextBlock Margin="10 0 0 1" VerticalAlignment="Bottom"
                       loc:L.Context="Storage savings" loc:L.Value="saved"
                       Foreground="{StaticResource TextControlForegroundDisabled}" />
            <Separator Height="30"
                       Margin="10 0 10 -2" VerticalAlignment="Bottom"
                       BorderThickness="1" />
            <ui:ProgressRing Width="14" Height="14"
                             Margin="0 0 5 4" VerticalAlignment="Bottom"
                             Foreground="#57dbff"
                             IsIndeterminate="{Binding IsAnalysingGames}"
                             Visibility="{Binding IsAnalysingGames, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <TextBlock VerticalAlignment="Bottom"
                       FontSize="20" Foreground="#57dbff" Opacity="0.6"
                       Text="{Binding TotalCanBeSaved, Converter={StaticResource BytesToReadableConverter}}" />
            <TextBlock Margin="10 0 0 1" VerticalAlignment="Bottom"
                       loc:L.Value="can be saved"
                       Foreground="{StaticResource TextControlForegroundDisabled}" />
        </StackPanel>

        <Separator Grid.Row="2" Height="1" VerticalAlignment="Bottom" />

        <Grid Grid.Row="3" Margin="14 10 34 8" Visibility="Visible">
            <Grid.ColumnDefinitions>
                <ColumnDefinition MaxWidth="108" />
                <ColumnDefinition Width="*" MinWidth="135" />
                <ColumnDefinition MinWidth="180" MaxWidth="190" />
                <ColumnDefinition MinWidth="60" MaxWidth="145" />
                <ColumnDefinition MinWidth="60" MaxWidth="145" />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>
            <CheckBox x:Name="SelectAllVisibleCheckBox"
                      Margin="-20 -10 0 -10" HorizontalAlignment="Left"
                      Click="OnSelectAllVisibleClick" IsThreeState="True"
                      ToolTip="{loc:T Select all visible games}" />
            <Button Grid.Column="1"
                    Margin="-23 0 0 0" Padding="0" HorizontalAlignment="Left"
                    Background="Transparent" BorderThickness="0"
                    Command="{Binding CycleSortCommand}"
                    CommandParameter="GameName" ToolTip="Sort by game name">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Margin="5 0 0 0" Foreground="{StaticResource CardForegroundDisabled}" Symbol="ArrowSort16">
                        <ui:SymbolIcon.Style>
                            <Style TargetType="ui:SymbolIcon">
                                <Setter Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{StaticResource CardForegroundDisabled}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveSortColumn}" Value="GameName">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:SymbolIcon.Style>
                    </ui:SymbolIcon>
                    <ui:SymbolIcon Margin="5 0 0 0" Foreground="{StaticResource CardForegroundDisabled}" Symbol="TextSortAscending16">
                        <ui:SymbolIcon.Style>
                            <Style TargetType="ui:SymbolIcon">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Setter Property="Foreground" Value="{StaticResource CardForegroundDisabled}" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding ActiveSortColumn}" Value="GameName" />
                                            <Condition Binding="{Binding IsSortDescending}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:SymbolIcon.Style>
                    </ui:SymbolIcon>
                    <ui:SymbolIcon Margin="5 0 0 0" Foreground="{StaticResource CardForegroundDisabled}" Symbol="TextSortDescending16">
                        <ui:SymbolIcon.Style>
                            <Style TargetType="ui:SymbolIcon">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Setter Property="Foreground" Value="{StaticResource CardForegroundDisabled}" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding ActiveSortColumn}" Value="GameName" />
                                            <Condition Binding="{Binding IsSortDescending}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:SymbolIcon.Style>
                    </ui:SymbolIcon>
                    <TextBlock Margin="5 0 0 0" Foreground="{StaticResource CardForegroundDisabled}" Text="{loc:T GAME, Context='Steam Library Tab Headings'}" />
                </StackPanel>
            </Button>
            <Button Grid.Column="2"
                    Margin="-2 0 0 0" Padding="0" HorizontalAlignment="Left"
                    Background="Transparent" BorderThickness="0"
                    Command="{Binding CycleSortCommand}"
                    CommandParameter="Status" ToolTip="Sort by status">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Margin="5 0 0 0" Foreground="{StaticResource CardForegroundDisabled}" Symbol="ArrowSort16">
                        <ui:SymbolIcon.Style>
                            <Style TargetType="ui:SymbolIcon">
                                <Setter Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{StaticResource CardForegroundDisabled}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveSortColumn}" Value="Status">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:SymbolIcon.Style>
                    </ui:SymbolIcon>
                    <ui:SymbolIcon Margin="5 0 0 0" Foreground="{StaticResource CardForegroundDisabled}" Symbol="TextSortAscending16">
                        <ui:SymbolIcon.Style>
                            <Style TargetType="ui:SymbolIcon">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Setter Property="Foreground" Value="{StaticResource CardForegroundDisabled}" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding ActiveSortColumn}" Value="Status" />
                                            <Condition Binding="{Binding IsSortDescending}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:SymbolIcon.Style>
                    </ui:SymbolIcon>
                    <ui:SymbolIcon Margin="5 0 0 0" Foreground="{StaticResource CardForegroundDisabled}" Symbol="TextSortDescending16">
                        <ui:SymbolIcon.Style>
                            <Style TargetType="ui:SymbolIcon">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Setter Property="Foreground" Value="{StaticResource CardForegroundDisabled}" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding ActiveSortColumn}" Value="Status" />
                                            <Condition Binding="{Binding IsSortDescending}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:SymbolIcon.Style>
                    </ui:SymbolIcon>
                    <TextBlock Margin="5 0 0 0" Foreground="{StaticResource CardForegroundDisabled}" Text="{loc:T STATUS, Context='Steam Library Tab Headings'}" />
                </StackPanel>
            </Button>
            <Button Grid.Column="3"
                    Margin="-50 0 0 0" Padding="0" HorizontalAlignment="Right"
                    Background="Transparent" BorderThickness="0"
                    Command="{Binding CycleSortCommand}"
                    CommandParameter="CurrentSize" ToolTip="Sort by current size">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Margin="5 0 0 0" Foreground="{StaticResource CardForegroundDisabled}" Symbol="ArrowSort16">
                        <ui:SymbolIcon.Style>
                            <Style TargetType="ui:SymbolIcon">
                                <Setter Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{StaticResource CardForegroundDisabled}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveSortColumn}" Value="CurrentSize">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:SymbolIcon.Style>
                    </ui:SymbolIcon>
                    <ui:SymbolIcon Margin="5 0 0 0" Foreground="{StaticResource CardForegroundDisabled}" Symbol="TextSortAscending16">
                        <ui:SymbolIcon.Style>
                            <Style TargetType="ui:SymbolIcon">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Setter Property="Foreground" Value="{StaticResource CardForegroundDisabled}" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding ActiveSortColumn}" Value="CurrentSize" />
                                            <Condition Binding="{Binding IsSortDescending}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:SymbolIcon.Style>
                    </ui:SymbolIcon>
                    <ui:SymbolIcon Margin="5 0 0 0" Foreground="{StaticResource CardForegroundDisabled}" Symbol="TextSortDescending16">
                        <ui:SymbolIcon.Style>
                            <Style TargetType="ui:SymbolIcon">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Setter Property="Foreground" Value="{StaticResource CardForegroundDisabled}" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding ActiveSortColumn}" Value="CurrentSize" />
                                            <Condition Binding="{Binding IsSortDescending}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:SymbolIcon.Style>
                    </ui:SymbolIcon>
                    <TextBlock Margin="5 0 0 0" Foreground="{StaticResource CardForegroundDisabled}" Text="{loc:T CURRENT SIZE, Context='Steam Library Tab Headings'}" />
                </StackPanel>
            </Button>
            <Button Grid.Column="4"
                    Padding="0" HorizontalAlignment="Right"
                    Background="Transparent" BorderThickness="0"
                    Command="{Binding CycleSortCommand}"
                    CommandParameter="Savings" ToolTip="Sort by savings">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Margin="5 0 0 0" Foreground="{StaticResource CardForegroundDisabled}" Symbol="ArrowSort16">
                        <ui:SymbolIcon.Style>
                            <Style TargetType="ui:SymbolIcon">
                                <Setter Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{StaticResource CardForegroundDisabled}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveSortColumn}" Value="Savings">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:SymbolIcon.Style>
                    </ui:SymbolIcon>
                    <ui:SymbolIcon Margin="5 0 0 0" Foreground="{StaticResource CardForegroundDisabled}" Symbol="TextSortAscending16">
                        <ui:SymbolIcon.Style>
                            <Style TargetType="ui:SymbolIcon">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Setter Property="Foreground" Value="{StaticResource CardForegroundDisabled}" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding ActiveSortColumn}" Value="Savings" />
                                            <Condition Binding="{Binding IsSortDescending}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:SymbolIcon.Style>
                    </ui:SymbolIcon>
                    <ui:SymbolIcon Margin="5 0 0 0" Foreground="{StaticResource CardForegroundDisabled}" Symbol="TextSortDescending16">
                        <ui:SymbolIcon.Style>
                            <Style TargetType="ui:SymbolIcon">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Setter Property="Foreground" Value="{StaticResource CardForegroundDisabled}" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding ActiveSortColumn}" Value="Savings" />
                                            <Condition Binding="{Binding IsSortDescending}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:SymbolIcon.Style>
                    </ui:SymbolIcon>
                    <TextBlock Margin="5 0 0 0" Foreground="{StaticResource CardForegroundDisabled}" Text="{loc:T SAVINGS, Context='Steam Library Tab Headings'}" />
                </StackPanel>
            </Button>
            <Button Grid.Column="5"
                    Margin="24 0 0 0" Padding="0" HorizontalAlignment="Right"
                    Background="Transparent" BorderThickness="0"
                    Command="{Binding CycleSortCommand}"
                    CommandParameter="RecommendedAction" ToolTip="Sort by recommended action">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Margin="5 0 0 0" Foreground="{StaticResource CardForegroundDisabled}" Symbol="ArrowSort16">
                        <ui:SymbolIcon.Style>
                            <Style TargetType="ui:SymbolIcon">
                                <Setter Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{StaticResource CardForegroundDisabled}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveSortColumn}" Value="RecommendedAction">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:SymbolIcon.Style>
                    </ui:SymbolIcon>
                    <ui:SymbolIcon Margin="5 0 0 0" Foreground="{StaticResource CardForegroundDisabled}" Symbol="TextSortAscending16">
                        <ui:SymbolIcon.Style>
                            <Style TargetType="ui:SymbolIcon">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Setter Property="Foreground" Value="{StaticResource CardForegroundDisabled}" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding ActiveSortColumn}" Value="RecommendedAction" />
                                            <Condition Binding="{Binding IsSortDescending}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:SymbolIcon.Style>
                    </ui:SymbolIcon>
                    <ui:SymbolIcon Margin="5 0 0 0" Foreground="{StaticResource CardForegroundDisabled}" Symbol="TextSortDescending16">
                        <ui:SymbolIcon.Style>
                            <Style TargetType="ui:SymbolIcon">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Setter Property="Foreground" Value="{StaticResource CardForegroundDisabled}" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding ActiveSortColumn}" Value="RecommendedAction" />
                                            <Condition Binding="{Binding IsSortDescending}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:SymbolIcon.Style>
                    </ui:SymbolIcon>
                    <TextBlock Margin="5 0 0 0" Foreground="{StaticResource CardForegroundDisabled}" Text="{loc:T RECOMMENDED ACTION, Context='Steam Library Tab Headings'}" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid x:Name="SteamGamesListBlurSource" Grid.Row="4">
            <ListView x:Name="SteamGamesList"
                      Grid.Row="4"
                      Padding="0" HorizontalContentAlignment="Stretch"
                      Background="Transparent" BorderThickness="0"
                      ItemsSource="{Binding FilteredSteamGames}"
                      ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      SelectedItem="{Binding SelectedGame, Mode=TwoWay}"
                      SelectionChanged="OnSteamGamesSelectionChanged" SelectionMode="Extended" TextOptions.TextRenderingMode="Grayscale" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                      VirtualizingPanel.VirtualizationMode="Recycling" Visibility="Visible">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel>
                            <VirtualizingStackPanel.Style>
                                <Style TargetType="VirtualizingStackPanel">
                                    <Setter Property="Margin" Value="0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.HasSelectedGames, RelativeSource={RelativeSource AncestorType=ListView}}" Value="True">
                                            <Setter Property="Margin" Value="0 0 0 90" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </VirtualizingStackPanel.Style>
                        </VirtualizingStackPanel>
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <ContentPresenter Margin="0 0 20 0" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0 0 0 8" Padding="14 10"
                                CornerRadius="6"
                                Tag="{Binding DataContext, ElementName=PageRoot}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource CardBackground}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="True">
                                            <Setter Property="Background" Value="#3044BEDF" />
                                        </DataTrigger>
                                        <EventTrigger RoutedEvent="MouseEnter">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#1044BEFF" Duration="0:0:0.1" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                        <EventTrigger RoutedEvent="MouseLeave">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="{StaticResource CardBackgroundFillColorDefault}" Duration="0:0:0.1" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>

                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Command="{Binding Tag.AddToCompressionQueueCommand}" CommandParameter="{Binding DataContext}" Header="{loc:T Add to Compression Queue}" />
                                    <MenuItem Command="{Binding Tag.GoToDatabaseResultsCommand}" CommandParameter="{Binding DataContext}" Header="{loc:T Go to Database Results}" />
                                    <Separator />

                                    <MenuItem Command="{Binding Tag.UncompressCommand}" CommandParameter="{Binding DataContext}" IsEnabled="{Binding DataContext.CanUncompress}">
                                        <MenuItem.Header>
                                            <StackPanel Orientation="Horizontal" ToolTipService.ShowOnDisabled="True">
                                                <TextBlock VerticalAlignment="Center" Text="{loc:T Uncompress}" />
                                                <Border Margin="10 0 0 0" Padding="5 5" VerticalAlignment="Center"
                                                        Background="#80C42B1C" CornerRadius="4" ToolTipService.ShowOnDisabled="True"
                                                        Visibility="{Binding DataContext.HasInsufficientFreeSpaceForUncompression, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:SymbolIcon Margin="0 1 3 0"
                                                                       FontSize="11"
                                                                       Foreground="{StaticResource PaletteRedBrush}"
                                                                       Symbol="Warning12" />
                                                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="White" Text="Not enough space" TextOptions.TextFormattingMode="Display" />
                                                    </StackPanel>
                                                    <Border.ToolTip>
                                                        <ToolTip>
                                                            <TextBlock Text="Not enough free space to safely uncompress this folder" TextWrapping="Wrap" />
                                                        </ToolTip>
                                                    </Border.ToolTip>
                                                </Border>
                                            </StackPanel>
                                        </MenuItem.Header>
                                    </MenuItem>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Grid MinHeight="58" TextBlock.Foreground="{StaticResource TextControlForeground}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition MaxWidth="108" />
                                    <ColumnDefinition Width="*" MinWidth="135" />
                                    <ColumnDefinition MinWidth="180" MaxWidth="190" />
                                    <ColumnDefinition MinWidth="60" MaxWidth="145" />
                                    <ColumnDefinition MinWidth="60" MaxWidth="145" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Margin="-20 0 0 0" HorizontalAlignment="Left" VerticalAlignment="Center" Panel.ZIndex="5"
                                          IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListViewItem}, Mode=TwoWay}">
                                    <CheckBox.Style>
                                        <Style BasedOn="{StaticResource {x:Type CheckBox}}" TargetType="CheckBox">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </CheckBox.Style>
                                </CheckBox>
                                <Border Width="170" Height="78"
                                        Margin="-14 -15 -150 -15" HorizontalAlignment="Left" VerticalAlignment="Center"
                                        CornerRadius="4">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding HeaderImage}" Stretch="UniformToFill" />
                                    </Border.Background>

                                </Border>
                                <StackPanel Grid.Column="1" Margin="0 0 16 0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock VerticalAlignment="Center"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   Text="{Binding GameName}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Border Height="25"
                                                Margin="8 0 0 0" Padding="6 3"
                                                Background="#80C42B1C" CornerRadius="4" Cursor="Help"
                                                Visibility="{Binding HasInsufficientFreeSpace, Converter={StaticResource BoolToVisConverter}}">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Margin="0 2 4 0" Foreground="{StaticResource PaletteRedBrush}" Symbol="Warning20" />
                                                <TextBlock VerticalAlignment="Center"
                                                           loc:L.Value="Not enough space" FontSize="11"
                                                           Foreground="{StaticResource ButtonForeground}" />
                                            </StackPanel>
                                            <Border.ToolTip>
                                                <ToolTip MaxWidth="300">
                                                    <TextBlock loc:L.Value="There is not enough free space on this drive to safely compress this folder. You need at least 50% of this folder's size free to ensure Windows does not cause issues." TextWrapping="Wrap" />
                                                </ToolTip>
                                            </Border.ToolTip>
                                        </Border>
                                        <Border Height="25"
                                                Margin="8 0 0 0" Padding="6 3"
                                                Background="#30FFAA00" CornerRadius="4"
                                                ToolTip="{loc:T 'This game uses DirectStorage technology. If you are using this feature, you should not compress this game.'}"
                                                Visibility="{Binding IsDirectStorage, Converter={StaticResource BoolToVisConverter}}">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Margin="0 2 4 0" Foreground="#ffe207" Symbol="Warning20" />
                                                <TextBlock VerticalAlignment="Center"
                                                           loc:L.Value="Direct Storage" FontSize="11" Foreground="#ffe207" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Margin="0 3 0 0"
                                               FontSize="12"
                                               Foreground="{StaticResource CardForegroundDisabled}"
                                               Text="{Binding DisplayPath}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding GamePath}" />
                                    <TextBlock Margin="0 3 0 0"
                                               FontSize="12" Foreground="#D1B13C"
                                               Text="{Binding OperationMessage}"
                                               Visibility="{Binding HasOperationMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                                    <Ellipse Width="13" Height="13" Margin="0 0 10 0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#D14A4F" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static local:SteamGameStatus.Compressed}">
                                                        <Setter Property="Fill" Value="#4bd18a" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static local:SteamGameStatus.RecentlyUpdated}">
                                                        <Setter Property="Fill" Value="#D1B13C" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static local:SteamGameStatus.PendingSteamUpdate}">
                                                        <Setter Property="Fill" Value="#44bedf" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static local:SteamGameStatus.Analysing}">
                                                        <Setter Property="Fill" Value="#8373808C" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock VerticalAlignment="Center" Foreground="{StaticResource CardForegroundDisabled}" Text="{Binding StatusMessage}" />
                                    <Border Width="40" Height="25"
                                            Margin="10 0 0 0" VerticalAlignment="Center"
                                            Background="#8373808C" CornerRadius="5"
                                            Visibility="{Binding IsCompressed, Converter={StaticResource BoolToVisConverter}}">
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontSize="11" FontWeight="SemiBold" Foreground="#FFF"
                                                   Text="{Binding CompressionLevel, Converter={StaticResource CompressionLevelAbbreviatedConverter}}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Grid.Column="3"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           FontSize="13"
                                           Text="{Binding CurrentFolderSize, Converter={StaticResource BytesToReadableConverter}}" />
                                <TextBlock Grid.Column="4"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           FontSize="13">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding DisplayedSavings, Converter={StaticResource BytesToReadableConverter}}" />
                                            <Setter Property="Foreground" Value="#45c1e8" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDisplayingActualSavings}" Value="True">
                                                    <Setter Property="Foreground" Value="#65dc9d" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HasSavingsData}" Value="False">
                                                    <Setter Property="Text" Value="—" />
                                                    <Setter Property="Foreground" Value="{StaticResource CardForegroundDisabled}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Grid Grid.Column="5" Margin="24 -10 -14 -10">
                                    <Grid.Resources>
                                        <DataTemplate x:Key="FullActionTextTemplate">
                                            <TextBlock Margin="0 0 20 0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding RecommendedAction}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static local:SteamGameStatus.PendingSteamUpdate}">
                                                                <Setter Property="Text" Value="{loc:T Update in Steam}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsCompressed}" Value="True">
                                                                <Setter Property="Text" Value="" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                        <DataTemplate x:Key="FullCompressActionTemplate">
                                            <ui:SplitButton Width="200"
                                                            Padding="14 8" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                                                            Background="#3000FF00"
                                                            Command="{Binding DataContext.CompressCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                            CommandParameter="{Binding}"
                                                            Content="{Binding RecommendedAction}"
                                                            Loaded="OnCompressSplitButtonLoaded">
                                                <ui:SplitButton.Flyout>
                                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                        <MenuItem Command="{Binding SelectCompressionModeCommand}" CommandParameter="{x:Static core:CompressionMode.XPRESS4K}" Header="X4K" />
                                                        <MenuItem Command="{Binding SelectCompressionModeCommand}" CommandParameter="{x:Static core:CompressionMode.XPRESS8K}" Header="X8K" />
                                                        <MenuItem Command="{Binding SelectCompressionModeCommand}" CommandParameter="{x:Static core:CompressionMode.XPRESS16K}" Header="X16K" />
                                                        <MenuItem Command="{Binding SelectCompressionModeCommand}" CommandParameter="{x:Static core:CompressionMode.LZX}" Header="LZX" />
                                                    </ContextMenu>
                                                </ui:SplitButton.Flyout>
                                            </ui:SplitButton>
                                        </DataTemplate>
                                        <DataTemplate x:Key="FullWorkingActionTemplate">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                                                <ui:ProgressRing Width="24" Height="24" IsIndeterminate="{Binding IsWorking}" />
                                                <ui:Button Width="32" Height="32"
                                                           Margin="12 0 0 0" Padding="0"
                                                           Command="{Binding DataContext.CancelOperationCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                           CommandParameter="{Binding}"
                                                           ToolTip="{loc:T Cancel operation}">
                                                    <ui:SymbolIcon Foreground="{StaticResource PaletteRedBrush}" Symbol="Dismiss12" />
                                                </ui:Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </Grid.Resources>
                                    <ContentControl HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Content="{Binding}">
                                        <ContentControl.Style>
                                            <Style TargetType="ContentControl">
                                                <Setter Property="ContentTemplate" Value="{StaticResource FullActionTextTemplate}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CanCompress}" Value="True">
                                                        <Setter Property="ContentTemplate" Value="{StaticResource FullCompressActionTemplate}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsWorking}" Value="True">
                                                        <Setter Property="ContentTemplate" Value="{StaticResource FullWorkingActionTemplate}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ContentControl.Style>
                                    </ContentControl>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>


        <Grid Grid.Row="3" Grid.RowSpan="2"
              Margin="0 10 0 0"
              Visibility="Collapsed">
            <!--  {Binding HasSelectedGame, Converter={StaticResource BooleanToVisibilityConverter}}">  -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListView Grid.Column="0"
                      Margin="0 0 0 10" Padding="0" HorizontalContentAlignment="Stretch"
                      Background="Transparent" BorderThickness="0"
                      ItemsSource="{Binding FilteredSteamGames}"
                      ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      SelectedItem="{Binding SelectedGame, Mode=TwoWay}"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.VirtualizationMode="Recycling">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Margin" Value="0 0 0 8" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Height="74"
                                Padding="8"
                                Background="{StaticResource CardBackground}"
                                CornerRadius="6"
                                Tag="{Binding DataContext, ElementName=PageRoot}">
                            <Border.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Command="{Binding Tag.AddToCompressionQueueCommand}" CommandParameter="{Binding DataContext}" Header="{loc:T Add to Compression Queue}" />
                                    <MenuItem Command="{Binding Tag.GoToDatabaseResultsCommand}" CommandParameter="{Binding DataContext}" Header="{loc:T Go to Database Results}" />
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Grid TextBlock.Foreground="{StaticResource TextControlForeground}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="112" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="104" Height="48"
                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Background="{StaticResource CardBackgroundPressed}"
                                        CornerRadius="4">
                                    <Image Source="{Binding HeaderImage}" Stretch="UniformToFill" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock FontSize="14" FontWeight="SemiBold"
                                               Text="{Binding GameName}"
                                               TextTrimming="CharacterEllipsis" />
                                    <Grid Margin="0 5 0 0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="10" Height="10" Margin="0 0 7 0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#D14A4F" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static local:SteamGameStatus.Compressed}">
                                                                <Setter Property="Fill" Value="#4bd18a" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static local:SteamGameStatus.RecentlyUpdated}">
                                                                <Setter Property="Fill" Value="#D1B13C" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static local:SteamGameStatus.PendingSteamUpdate}">
                                                                <Setter Property="Fill" Value="#44bedf" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock VerticalAlignment="Center"
                                                       FontSize="12"
                                                       Foreground="{StaticResource CardForegroundDisabled}"
                                                       Text="{Binding StatusMessage}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1"
                                                    Margin="10 0 5 0" HorizontalAlignment="Right"
                                                    Orientation="Horizontal" TextBlock.FontWeight="SemiBold" TextOptions.TextFormattingMode="Display">
                                            <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="#45c1e8">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="~" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCompressed}" Value="True">
                                                                <Setter Property="Text" Value="" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Margin="5 0 0 0" VerticalAlignment="Center"
                                                       FontSize="12"
                                                       Text="{Binding DetailSavings, Converter={StaticResource BytesToReadableConverter}}"
                                                       TextAlignment="Right">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#45c1e8" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCompressed}" Value="True">
                                                                <Setter Property="Foreground" Value="#65dc9d" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Border x:Name="DetailCard"
                    Grid.Column="2"
                    Margin="0 0 00 10"
                    Background="{StaticResource CardBackground}"
                    ClipToBounds="True" CornerRadius="6" SizeChanged="OnDetailCardSizeChanged">
                <ContentControl Content="{Binding SelectedGame}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate>
                            <ScrollViewer HorizontalContentAlignment="Stretch" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <Grid TextBlock.Foreground="{StaticResource TextControlForeground}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="220" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Rectangle Grid.Row="0" RadiusX="8" RadiusY="8">
                                        <Rectangle.Fill>
                                            <ImageBrush ImageSource="{Binding HeaderImage}" Stretch="UniformToFill" />
                                        </Rectangle.Fill>
                                        <Rectangle.OpacityMask>
                                            <LinearGradientBrush StartPoint="0.5,0.3" EndPoint="0.5,1">
                                                <GradientStop Offset="0" Color="White" />
                                                <GradientStop Offset="1" Color="Transparent" />
                                            </LinearGradientBrush>
                                        </Rectangle.OpacityMask>
                                        <Rectangle.Effect>
                                            <BlurEffect KernelType="Gaussian" Radius="64" RenderingBias="Quality" />
                                        </Rectangle.Effect>
                                    </Rectangle>
                                    <Rectangle Grid.Row="0" Height="290" Fill="#40000000">
                                        <Rectangle.OpacityMask>
                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,0.7">
                                                <GradientStop Offset="0" Color="White" />
                                                <GradientStop Offset="1" Color="Transparent" />
                                            </LinearGradientBrush>
                                        </Rectangle.OpacityMask>
                                    </Rectangle>

                                    <Grid Grid.Row="0" Margin="20 20 20 50">
                                        <ui:Button HorizontalAlignment="Left" VerticalAlignment="Top"
                                                   Appearance="Transparent"
                                                   Command="{Binding DataContext.ClearSelectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Margin="0 0 6 0" Symbol="ArrowLeft20" />
                                                <TextBlock VerticalAlignment="Center" Text="All games" />
                                            </StackPanel>
                                        </ui:Button>

                                        <StackPanel VerticalAlignment="Bottom">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                    <TextBlock VerticalAlignment="Center"
                                                               FontSize="24" FontWeight="SemiBold"
                                                               Text="{Binding GameName}"
                                                               TextWrapping="Wrap" />
                                                    <!--<Border Grid.Column="1"
                                                            Height="25"
                                                            Margin="12 0 0 0" Padding="6 3"
                                                            Background="#30D1B13C" CornerRadius="4"
                                                            ToolTip="{loc:T 'This game uses DirectStorage technology. If you are using this feature, you should not compress this game.'}"
                                                            Visibility="{Binding IsDirectStorage, Converter={StaticResource BoolToVisConverter}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <ui:SymbolIcon Margin="0 2 4 0" Foreground="#e8d69b" Symbol="Warning20" />
                                                            <TextBlock VerticalAlignment="Center"
                                                                       loc:L.Value="Direct Storage" FontSize="11" Foreground="#e8d69b" />
                                                        </StackPanel>
                                                    </Border>-->
                                                </StackPanel>

                                                <TextBlock Grid.Column="1"
                                                           Margin="0 5 0 0"
                                                           Foreground="{StaticResource CardForegroundDisabled}"
                                                           Text="{Binding DisplayPath, Converter={StaticResource TokenisedFolderPathConverter}}"
                                                           TextWrapping="Wrap" />


                                            </Grid>
                                            <StackPanel Height="24"
                                                        Margin="0 8 0 0"
                                                        Orientation="Horizontal" TextOptions.TextFormattingMode="Display">
                                                <Ellipse Width="11" Height="11" Margin="0 0 9 -2">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="#D14A4F" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static local:SteamGameStatus.Compressed}">
                                                                    <Setter Property="Fill" Value="#4bd18a" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static local:SteamGameStatus.RecentlyUpdated}">
                                                                    <Setter Property="Fill" Value="#D1B13C" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static local:SteamGameStatus.PendingSteamUpdate}">
                                                                    <Setter Property="Fill" Value="#44bedf" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock VerticalAlignment="Center" Text="{Binding StatusMessage}" />
                                                <Border Height="24"
                                                        Margin="10 0 0 0" Padding="8 2"
                                                        Background="#8373808C" CornerRadius="5"
                                                        Visibility="{Binding IsCompressed, Converter={StaticResource BoolToVisConverter}}">
                                                    <TextBlock VerticalAlignment="Center"
                                                               FontSize="11" FontWeight="SemiBold" Foreground="#FFF"
                                                               Text="{Binding CompressionLevel, Converter={StaticResource CompressionLevelAbbreviatedConverter}}" />
                                                </Border>

                                                <TextBlock Margin="20 0" VerticalAlignment="Center"
                                                           FontWeight="SemiBold" Foreground="#44bedf"
                                                           Text="{Binding OperationMessage}"
                                                           Visibility="{Binding HasOperationMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            </StackPanel>




                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Grid.Row="1" Margin="20 -10 20 20" UseLayoutRounding="True">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="150" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.ColumnSpan="2"
                                                    Height="80"
                                                    Padding="20 15" VerticalAlignment="Top"
                                                    Background="#00FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition MaxWidth="200" />
                                                        <ColumnDefinition MaxWidth="200" />
                                                        <ColumnDefinition MaxWidth="200" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition />
                                                        <RowDefinition Height="30" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock FontSize="13" Foreground="{StaticResource CardForegroundDisabled}" Text="Current size" />
                                                    <TextBlock Grid.Row="1" FontSize="20" Text="{Binding CurrentFolderSize, Converter={StaticResource BytesToReadableConverter}}" />
                                                    <TextBlock Grid.Column="1"
                                                               FontSize="13"
                                                               Foreground="{StaticResource CardForegroundDisabled}"
                                                               Text="Base size" />
                                                    <TextBlock Grid.Row="1" Grid.Column="1"
                                                               FontSize="20"
                                                               Text="{Binding UncompressedBytes, Converter={StaticResource BytesToReadableConverter}}" />
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal">

                                                        <TextBlock Grid.Column="2"
                                                                   FontSize="13"
                                                                   Foreground="{StaticResource CardForegroundDisabled}"
                                                                   Text="Estimated ">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCompressed}" Value="False">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Grid.Column="2"
                                                                   FontSize="13"
                                                                   Foreground="{StaticResource CardForegroundDisabled}"
                                                                   Text="Savings" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Row="1" Grid.Column="2"
                                                               Margin="-13 4 0 0"
                                                               FontSize="18" Foreground="#44bedf">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCompressed}" Value="False">
                                                                        <Setter Property="Text" Value="~" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal">

                                                        <TextBlock Grid.Row="1" Grid.Column="2"
                                                                   VerticalAlignment="Bottom"
                                                                   FontSize="20"
                                                                   Text="{Binding DetailSavings, Converter={StaticResource BytesToReadableConverter}}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#65dc9d" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCompressed}" Value="False">
                                                                            <Setter Property="Foreground" Value="#44bedf" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>

                                                        <TextBlock Margin="10 0 0 3" VerticalAlignment="Bottom"
                                                                   FontSize="14"
                                                                   Foreground="{StaticResource TextControlForegroundDisabled}"
                                                                   Text="{Binding SavingsPercentage, StringFormat={}{0:0}%}"
                                                                   TextOptions.TextFormattingMode="Display" />


                                                    </StackPanel>

                                                </Grid>
                                            </Border>
                                            <ProgressBar Grid.ColumnSpan="2"
                                                         Height="8"
                                                         VerticalAlignment="Bottom"
                                                         Background="#60FFFFFF" BorderThickness="0"
                                                         Value="{Binding SavingsPercentage, Mode=OneWay}">
                                                <ProgressBar.Style>
                                                    <Style BasedOn="{StaticResource {x:Type ProgressBar}}" TargetType="ProgressBar">
                                                        <Setter Property="Foreground" Value="#65dc9d" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCompressed}" Value="False">
                                                                <Setter Property="Foreground" Value="#44bedf" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ProgressBar.Style>
                                            </ProgressBar>

                                        </Grid>



                                        <ui:Card Margin="0 10 0 0"
                                                 Background="#30D1B13C" BorderBrush="Transparent"
                                                 Visibility="{Binding IsDirectStorage, Converter={StaticResource BoolToVisConverter}}">
                                            <TextBlock FontSize="12" TextWrapping="Wrap">
                                                <ui:SymbolIcon Margin="0 0 0 -2" Foreground="#e8d69b" Symbol="Warning12" />
                                                <Run Text="Direct Storage Detected." />
                                                <Run Foreground="#e8d69b" Text="Compression may affect asset streaming performance for this game and is not recommended if you're using this technology." />
                                            </TextBlock>
                                        </ui:Card>
                                        <Separator Margin="0 10 0 0" />

                                        <TextBlock Margin="0 15 0 10"
                                                   FontSize="13"
                                                   Foreground="{StaticResource TextControlForegroundDisabled}"
                                                   Text="COMPRESSION " />



                                        <ui:Card Margin="0 0 0 10"
                                                 Background="#30D1B13C" BorderBrush="Transparent"
                                                 Visibility="{Binding IsCompressionRecommended, Converter={StaticResource BooleanToInverseVisibilityConverter}}">
                                            <TextBlock FontSize="12" TextWrapping="Wrap">
                                                <ui:SymbolIcon Margin="0 0 0 -2" Foreground="#e8d69b" Symbol="Warning12" />
                                                <Run Text="Compression is not recommended for this game." />
                                            </TextBlock>
                                        </ui:Card>

                                        <ComboBox Height="42"
                                                  VerticalContentAlignment="Center"
                                                  BorderBrush="#50FFFFFF" BorderThickness="1" DisplayMemberPath="DisplayName"
                                                  ItemsSource="{Binding CompressionModeOptions}"
                                                  SelectedItem="{Binding SelectedCompressionOption, Mode=TwoWay}"
                                                  Visibility="{Binding IsCompressionRecommended, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="220" />
                                            </Grid.ColumnDefinitions>
                                            <Button Height="42"
                                                    Margin="0 10 0 0" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                    BorderBrush="#50FFFFFF" BorderThickness="1"
                                                    Command="{Binding DataContext.EditSkipListCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <Grid Height="42" Margin="10 0 -5 0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="50" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Orientation="Horizontal">

                                                        <TextBlock VerticalAlignment="Center" Text="SKIPLIST" />
                                                        <Separator Margin="5 0" />

                                                        <ItemsControl VerticalAlignment="Center" ItemsSource="{Binding CompressionOptions.SkipList}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border MinWidth="40"
                                                                            Margin="5 0" Padding="5 5"
                                                                            Background="#40FFFFFF" CornerRadius="4">
                                                                        <TextBlock FontSize="12" Text="{Binding}" TextAlignment="Center" />

                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                    </StackPanel>

                                                    <ui:SymbolIcon Grid.Column="1" FontSize="20" Symbol="WindowSettings20" />

                                                </Grid>
                                                <Button.Style>
                                                    <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
                                                        <Setter Property="IsEnabled" Value="True" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsWorking}" Value="True">
                                                                <Setter Property="IsEnabled" Value="False" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <Grid Grid.Column="1" Margin="10 10 0 0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <ContentControl Content="{Binding}">
                                                    <ContentControl.Resources>
                                                        <DataTemplate x:Key="CompressTemplate">
                                                            <ui:Button Height="42"
                                                                       HorizontalAlignment="Stretch"
                                                                       Background="#304BD18A" BorderBrush="#654BD18A"
                                                                       Command="{Binding DataContext.CompressCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                       CommandParameter="{Binding}"
                                                                       Content="{loc:T Compress}"
                                                                       IsEnabled="{Binding CanCompress}" />
                                                        </DataTemplate>
                                                        <DataTemplate x:Key="NoActionTemplate">
                                                            <Grid />
                                                        </DataTemplate>
                                                        <DataTemplate x:Key="UncompressTemplate">
                                                            <ui:Button Height="42"
                                                                       HorizontalAlignment="Stretch"
                                                                       Appearance="Danger"
                                                                       Command="{Binding DataContext.UncompressCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                       CommandParameter="{Binding}"
                                                                       Content="{loc:T Uncompress}"
                                                                       IsEnabled="{Binding CanUncompress}" />
                                                        </DataTemplate>
                                                        <DataTemplate x:Key="WorkingTemplate">
                                                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                                                <ui:ProgressRing Width="28" Height="28" IsIndeterminate="{Binding IsWorking}" />
                                                                <ui:Button Width="36" Height="36"
                                                                           Margin="12 0 0 0" Padding="0"
                                                                           Command="{Binding DataContext.CancelOperationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                           CommandParameter="{Binding}"
                                                                           ToolTip="{loc:T Cancel operation}">
                                                                    <ui:SymbolIcon Foreground="{StaticResource PaletteRedBrush}" Symbol="Dismiss12" />
                                                                </ui:Button>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ContentControl.Resources>
                                                    <ContentControl.Style>
                                                        <Style TargetType="ContentControl">
                                                            <Setter Property="ContentTemplate" Value="{StaticResource CompressTemplate}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCompressionRecommended}" Value="False">
                                                                    <Setter Property="ContentTemplate" Value="{StaticResource NoActionTemplate}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsCompressed}" Value="True">
                                                                    <Setter Property="ContentTemplate" Value="{StaticResource UncompressTemplate}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsWorking}" Value="True">
                                                                    <Setter Property="ContentTemplate" Value="{StaticResource WorkingTemplate}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ContentControl.Style>
                                                </ContentControl>

                                            </Grid>

                                        </Grid>

                                        <Separator Margin="0 10 0 0" />

                                        <Grid Margin="0 10 0 0" TextOptions.TextFormattingMode="Display" Visibility="{Binding IsWatched, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="20" />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>

                                            <Grid.RowDefinitions>
                                                <RowDefinition />
                                                <RowDefinition />
                                            </Grid.RowDefinitions>

                                            <ui:SymbolIcon VerticalAlignment="Center" Foreground="{StaticResource TextControlForegroundDisabled}" Symbol="SearchVisual16" />
                                            <StackPanel Grid.Column="1" Margin="10 0">
                                                <TextBlock Margin="0 0 0 7"
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextControlForegroundDisabled}"
                                                           Text="LAST ANALYSED " />
                                                <TextBlock FontSize="12" Text="{Binding WatchlistEntry.LastCheckedDate, Converter={StaticResource RelativeDateConverter}}" />
                                            </StackPanel>

                                            <ui:SymbolIcon Grid.Row="1"
                                                           Margin="0 15 0 0" VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextControlForegroundDisabled}"
                                                           Symbol="Box16" />
                                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="10 15 0 0">
                                                <TextBlock Margin="0 0 0 7"
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextControlForegroundDisabled}"
                                                           Text="LAST COMPRESSED " />
                                                <TextBlock FontSize="12" Text="{Binding WatchlistEntry.LastCompressedDate, Converter={StaticResource RelativeDateConverter}}" />
                                            </StackPanel>

                                        </Grid>




                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </Border>
        </Grid>


        <Border Grid.Row="4"
                Width="{Binding ElementName=Compression_Options_Overlay, Path=ActualWidth}"
                Height="{Binding ElementName=Compression_Options_Overlay, Path=ActualHeight}"
                Margin="20 0 40 12" HorizontalAlignment="Center" VerticalAlignment="Bottom" Panel.ZIndex="20"
                Background="#445667" BorderThickness="1" CornerRadius="8"
                Visibility="{Binding HasSelectedGames, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" Opacity="0.6" />
            </Border.Effect>
        </Border>


        <Border x:Name="Compression_Options_Overlay"
                Grid.Row="4"
                Margin="20 0 40 12" Padding="15 16" HorizontalAlignment="Center" VerticalAlignment="Bottom" Panel.ZIndex="20"
                local:LiveBlurBackground.BlurOpacity="0.7" local:LiveBlurBackground.EnableBlur="True"
                local:LiveBlurBackground.Source="{Binding ElementName=SteamGamesList}"
                Background="#445667" BorderBrush="#50FFFFFF" BorderThickness="1" CornerRadius="8"
                Visibility="{Binding HasSelectedGames, Converter={StaticResource BooleanToVisibilityConverter}}">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock loc:L.Value="COMPRESSION MODE " FontSize="12" Foreground="{StaticResource TextControlForegroundDisabled}" />
                    <CheckBox Margin="-10 0 0 0" Content="{loc:T Use recommended mode}" IsChecked="{Binding UseRecommendedCompressionLevel}" />
                    <ComboBox Grid.Column="2"
                              Height="36"
                              SelectedValue="{Binding QueueCompressionMode}"
                              SelectedValuePath="Tag">
                        <ComboBox.Style>
                            <Style BasedOn="{StaticResource {x:Type ComboBox}}" TargetType="ComboBox">
                                <Setter Property="IsEnabled" Value="True" />
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UseRecommendedCompressionLevel}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.Style>
                        <ComboBox.Items>
                            <ComboBoxItem Content="XPRESS 4K" Tag="{x:Static core:CompressionMode.XPRESS4K}" />
                            <ComboBoxItem Content="XPRESS 8K" Tag="{x:Static core:CompressionMode.XPRESS8K}" />
                            <ComboBoxItem Content="XPRESS 16K" Tag="{x:Static core:CompressionMode.XPRESS16K}" />
                            <ComboBoxItem Content="LZX" Tag="{x:Static core:CompressionMode.LZX}" />
                        </ComboBox.Items>
                    </ComboBox>
                </StackPanel>

                <Separator Grid.Column="1" Margin="10 0 10 0" />

                <StackPanel Grid.Column="2">
                    <TextBlock loc:L.Value="SKIPLIST SELECTION" FontSize="12" Foreground="{StaticResource TextControlForegroundDisabled}" />
                    <StackPanel Orientation="Horizontal">
                        <CheckBox Grid.Column="3"
                                  Margin="-10 0 0 0"
                                  Content="{loc:T Include global skiplist}"
                                  IsChecked="{Binding UseGlobalSkiplist}" />
                        <CheckBox Grid.Column="4" Content="{loc:T Include smart skiplist}" IsChecked="{Binding UseSmartSkiplist}" />
                    </StackPanel>

                </StackPanel>

                <Separator Grid.Column="3" Margin="10 0 10 0" />

                <ui:Button Grid.Column="6"
                           Height="48"
                           Margin="10 0 0 0" Padding="18 0"
                           Background="#278A52"
                           Command="{Binding AddSelectedToQueueCommand}"
                           Content="{loc:T Add selected to queue}" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="4"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#90000000" IsHitTestVisible="False"
                    Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ui:ProgressRing Width="42" Height="42"
                             Margin="0 20 0 0" HorizontalAlignment="Center"
                             IsIndeterminate="{Binding IsLoading}" />
            <TextBlock Margin="20 12 20 20" Foreground="{StaticResource CardForegroundDisabled}" Text="{loc:T Scanning installed Steam games...}" />
        </StackPanel>
        <StackPanel Grid.Row="4"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    IsHitTestVisible="False"
                    Visibility="{Binding HasNoGames, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ui:SymbolIcon HorizontalAlignment="Center" FontSize="36" Symbol="Games24" />
            <TextBlock Margin="0 12 0 0" FontSize="16" Text="{loc:T No installed Steam games were found.}" />
        </StackPanel>
        <Border Grid.Row="4"
                Margin="0 12 0 0" Padding="12" HorizontalAlignment="Stretch" VerticalAlignment="Top"
                Background="#33D9534F" CornerRadius="6" IsHitTestVisible="False"
                Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Foreground="{StaticResource CardForeground}" Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
        </Border>
    </Grid>
</UserControl>
