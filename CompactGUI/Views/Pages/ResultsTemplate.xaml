<UserControl x:Class="ResultsTemplate"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="clr-namespace:LazyTranslate;assembly=LazyTranslate"
             xmlns:local="clr-namespace:CompactGUI"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             d:DesignHeight="450"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <Grid Margin="0 30 0 0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
          d:DataContext="{d:DesignInstance Type=local:FolderViewModel}">

        <Grid.ColumnDefinitions>
            <ColumnDefinition MinWidth="10" />
            <ColumnDefinition MaxWidth="90" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <TextBlock HorizontalAlignment="Left"
                   loc:L.Value="Compression Summary" FontSize="14" FontWeight="SemiBold" TextOptions.TextFormattingMode="Display" />

        <Grid Grid.Row="1" Grid.ColumnSpan="2"
              Margin="0 20" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition MaxWidth="220" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Border Grid.ColumnSpan="7"
                    Height="100"
                    Background="#08FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="6" />

            <StackPanel Margin="20 0" VerticalAlignment="Center">

                <TextBlock FontSize="30" FontWeight="SemiBold" Foreground="#58d895"
                           Text="{Binding Folder.BytesSaved, Converter={StaticResource BytesToReadableConverter}}" />

                <TextBlock Grid.Row="3" Grid.Column="0"
                           Margin="0 5 0 6" HorizontalAlignment="Left"
                           FontSize="12" FontWeight="SemiBold" Foreground="#58d895"
                           Text="{Binding Folder.CompressionRatio, Mode=OneWay, Converter={StaticResource DecimalToPercentageConverter}, ConverterParameter='IF', StringFormat='{}{0} saved'}"
                           TextOptions.TextFormattingMode="Display" />

            </StackPanel>
            <Separator Grid.Column="1"
                       Margin="0 10"
                       BorderBrush="#40FFFFFF" BorderThickness="1" />

            <Grid Grid.Column="2" Margin="30 10" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="80" MaxWidth="150" />
                    <ColumnDefinition Width="*" MaxWidth="100" />
                    <ColumnDefinition Width="auto" MinWidth="35" />
                    <ColumnDefinition Width="*" MaxWidth="150" />
                    <ColumnDefinition Width="*" MinWidth="80" MaxWidth="150" />

                    <ColumnDefinition Width="*" MinWidth="80" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <TextBlock FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource TextControlForegroundDisabled}"
                           Text="Original Size" TextOptions.TextFormattingMode="Display" />
                <TextBlock Grid.Row="1"
                           FontSize="20" FontWeight="SemiBold"
                           Text="{Binding Folder.UncompressedBytes, Converter={StaticResource BytesToReadableConverter}}" />


                <ui:SymbolIcon Grid.Row="1" Grid.Column="2"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{StaticResource TextControlForegroundDisabled}"
                               Symbol="ArrowRight20" />


                <TextBlock Grid.Column="4"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource TextControlForegroundDisabled}"
                           Text="Current Size" TextOptions.TextFormattingMode="Display" />
                <TextBlock Grid.Row="1" Grid.Column="4"
                           FontSize="20" FontWeight="SemiBold"
                           Text="{Binding Folder.CompressedBytes, Converter={StaticResource BytesToReadableConverter}}" />

                <ProgressBar Grid.Row="2" Grid.ColumnSpan="6"
                             Height="8"
                             Margin="0 5"
                             Background="#40FFFFFF" BorderThickness="0" FlowDirection="RightToLeft" Foreground="#58d895"
                             Maximum="{Binding Folder.UncompressedBytes}"
                             Value="{Binding Folder.BytesSaved, Mode=OneWay}" />


            </Grid>

        </Grid>

        <Separator Grid.Row="2" Grid.ColumnSpan="2"
                   Margin="0 5" VerticalAlignment="Top" />
        <Grid Grid.Row="3" Grid.ColumnSpan="2"
              Margin="20 10 0 10" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="110" MaxWidth="200" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" MinWidth="70" MaxWidth="200" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" MinWidth="145" MaxWidth="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition />
            </Grid.RowDefinitions>



            <TextBlock FontSize="10" FontWeight="SemiBold"
                       Foreground="{StaticResource TextControlForegroundDisabled}"
                       Text="FILES COMPRESSED" TextOptions.TextFormattingMode="Display" />

            <TextBlock Grid.Row="1"
                       Margin="0 8 0 0"
                       FontSize="13" FontWeight="SemiBold" TextOptions.TextFormattingMode="Display">
                <Run Text="{Binding TotalCompressedFiles, Mode=OneWay}" />
                <Run Text="of" />
                <Run Text="{Binding TotalFiles, Mode=OneWay}" />
            </TextBlock>

            <Separator Grid.RowSpan="2" Grid.Column="1"
                       Margin="0 -2" HorizontalAlignment="Left"
                       BorderBrush="#40FFFFFF" />

            <TextBlock Grid.Column="2"
                       FontSize="10" FontWeight="SemiBold"
                       Foreground="{StaticResource TextControlForegroundDisabled}"
                       Text="METHOD" TextOptions.TextFormattingMode="Display" />

            <TextBlock Grid.Row="1" Grid.Column="2"
                       Margin="0 8 0 0"
                       FontSize="13" FontWeight="SemiBold"
                       Text="{Binding DominantCompressionMode, Converter={StaticResource CompressionLevelAbbreviatedConverter}}"
                       TextOptions.TextFormattingMode="Display" />


            <Separator Grid.RowSpan="2" Grid.Column="3"
                       Margin="0 -2" HorizontalAlignment="Left"
                       BorderBrush="#40FFFFFF" />

            <TextBlock Grid.Column="4"
                       FontSize="10" FontWeight="SemiBold"
                       Foreground="{StaticResource TextControlForegroundDisabled}"
                       Text="FOLDER MONITORING" TextOptions.TextFormattingMode="Display" />

            <TextBlock Grid.Row="1" Grid.Column="4"
                       Margin="0 8 0 0"
                       FontSize="13" FontWeight="SemiBold" TextOptions.TextFormattingMode="Display">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="DISABLED" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Folder.CompressionOptions.WatchFolderForChanges}" Value="True">
                                <Setter Property="Text" Value="ENABLED" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>




        </Grid>


        <Separator Grid.Row="4" Grid.ColumnSpan="2"
                   Margin="0 5" VerticalAlignment="Top" />



        <StackPanel Grid.Row="6" Grid.ColumnSpan="2"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Orientation="Horizontal">

            <ui:Button MinWidth="140" Height="40"
                       Margin="0 0 0 10"
                       Background="{StaticResource CardBackgroundFillColorSecondaryBrush}"
                       Command="{Binding UncompressCommand}"
                       FontSize="16">
                <StackPanel Orientation="Horizontal">
                    <TextBlock loc:L.Value="Uncompress" VerticalAlignment="Center"/>
                    <Border Margin="10 0 0 0" Padding="10 5" VerticalAlignment="Center"
                            Background="#80C42B1C" CornerRadius="4" ToolTipService.ShowOnDisabled="True"
                            Visibility="{Binding Folder.HasInsufficientFreeSpaceForUncompression, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Margin="0 1 3 0"
                                           FontSize="11"
                                           Foreground="{StaticResource PaletteRedBrush}"
                                           Symbol="Warning12" />
                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="White" Text="Not enough space" TextOptions.TextFormattingMode="Display" />
                        </StackPanel>
                        <Border.ToolTip>
                            <ToolTip>
                                <TextBlock Text="Not enough free space to safely uncompress this folder" TextWrapping="Wrap" />
                            </ToolTip>
                        </Border.ToolTip>
                    </Border>
                </StackPanel>
            </ui:Button>
            <ui:Button Width="140" Height="40"
                       Margin="40 0 0 10"
                       loc:L.Value="Compress Again"
                       Background="{StaticResource CardBackgroundFillColorSecondaryBrush}"
                       Command="{Binding CompressAgainCommand}"
                       Visibility="{Binding Folder.IsFreshlyCompressed, Converter={StaticResource BooleanToInverseVisibilityConverter}}" />
            <ui:Button Width="140" Height="40"
                       Margin="40 0 0 10"
                       loc:L.Value="Submit Results"
                       Background="{StaticResource CardBackgroundFillColorSecondaryBrush}"
                       Command="{Binding SubmitToWikiCommand}">
                <ui:Button.Visibility>
                    <MultiBinding Converter="{StaticResource IsSteamFolderAndFreshlyCompressedMultiConverter}">
                        <Binding Path="Folder.IsFreshlyCompressed" />
                        <Binding Converter="{StaticResource IsSteamFolderConverter}" Path="Folder" />
                    </MultiBinding>
                </ui:Button.Visibility>
            </ui:Button>

        </StackPanel>




    </Grid>

</UserControl>

